[sub_resource type="GDScript" id="GDScript_5omm6"]
script/source = "extends Node2D
@onready var hit_box: Area2D = $HitBox
@onready var muzzle: Marker2D = $Muzzle
@onready var stream: Line2D = $Stream
@onready var water_chunks: Node2D = $WaterChunks
const CHUNK = preload(\"res://water.png\")
var chunks = []
var start
var chunk_spacing = 10.0
var max_chunks = 200
var chunk_speed = 1

func update_chunks(mouse: Vector2, delta: float):
	start = muzzle.global_position
	var end = mouse

	var direction = (end - start).normalized()
	var perpendicular = Vector2(-direction.y, direction.x)

	for chunk in chunks:
		var sprite = chunk[\"sprite\"]
		var t = chunk[\"t\"]

		t += chunk_speed * delta

		if t >= 1.0:
			t -= 1.0

			sprite.rotation = randf_range(0.0, TAU)
			chunk[\"size_mult\"] = randf_range(0.6, 1)
			chunk[\"offset\"] = randf_range(-8.0, 8.0)

		chunk[\"t\"] = t

		# Base position along stream
		var point = start.lerp(end, t)

		# Slight random sideways displacement
		var offset_scale = lerp(1.0, 0.3, t)
		point += perpendicular * chunk[\"offset\"] * offset_scale

		sprite.global_position = point
		sprite.visible = true
		# Perspective scaling
		var size = lerp(1.5, 0.35, t)
		size *= chunk[\"size_mult\"]

		sprite.scale = Vector2.ONE * size
		
func update_chunk_count(mouse: Vector2):
	var distance = muzzle.global_position.distance_to(mouse)
	var desired_count = int(distance / chunk_spacing)

	desired_count = clamp(desired_count, 5, max_chunks)

	while chunks.size() < desired_count:
		add_chunk()

	while chunks.size() > desired_count:
		remove_chunk()


func add_chunk():
	var sprite = Sprite2D.new()
	sprite.texture = CHUNK
	sprite.rotation = randf_range(0.0, TAU)
	sprite.visible = false
	water_chunks.add_child(sprite)

	chunks.append({
		\"sprite\": sprite,
		\"t\": randf(),
		\"size_mult\": randf_range(0.8, 1.2),
		\"offset\": randf_range(-8.0, 8.0)
	})
func remove_chunk():
	var chunk = chunks.pop_back()
	chunk[\"sprite\"].queue_free()
	
func update_stream(mouse: Vector2):
	var start = muzzle.global_position
	var end = mouse
	var point_count = 16

	var direction = (end - start).normalized()
	var perpendicular = Vector2(-direction.y, direction.x)
	var time = Time.get_ticks_msec() * 0.01

	stream.clear_points()

	for i in range(point_count):
		var t = float(i) / float(point_count - 1)
		var point = start.lerp(end, t)

		# Very subtle water movement
		if i != 0 and i != point_count - 1:
			var wave = sin(t * 20.0 + time) * 1.5
			point += perpendicular * wave

		stream.add_point(stream.to_local(point))
# Called when the node enters the scene tree for the first time.
func _ready():
	pass

# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta):
	var mouse = get_global_mouse_position()

	hit_box.global_position = mouse
	if Input.is_mouse_button_pressed(MOUSE_BUTTON_LEFT):
		
		update_chunks(mouse, delta)
		update_chunk_count(mouse)
	else:
		while not chunks.is_empty():
			remove_chunk()
"

