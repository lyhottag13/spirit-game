resource_name = "spirit_entity"
script/source = "extends Node2D
signal wet
@onready var sprite_2d: Sprite2D = $Sprite2D
@onready var collision: CollisionPolygon2D = $Area2D/CollisionPolygon2D

var spirit_name = \"pirate\"
var speed = 500.0 # Base speed the ghost returns to
var panic = 0.5 # How strongly pressure increases difficulty
var accel_mult = 1.5 # How quickly speed returns to base speed
var resize = 1

var move_interval = 1 # base Average time between moves
var move_timer = 0 #live timer the ghost uses
var turn_timer = 0#timer used to for turns
var turn_speed = 0#speed for turns

var base_difficulty = 0.2

var movement_weight = 70
var teleport_weight = 25
var special_weight = 5

var velocity = Vector2(200, 200).normalized() * speed

var radius = 45 # Distance ghost center stays from screen edge
var current_pressure = 0.0
# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	var current_ghost := Classes.Ghost.new()
	movement_weight = current_ghost.fight_mode_data.movement_weight
	teleport_weight = current_ghost.fight_mode_data.teleport_weight
	special_weight = current_ghost.fight_mode_data.special_weight
	base_difficulty = current_ghost.fight_mode_data.difficulty
	speed = current_ghost.fight_mode_data.speed
	panic = current_ghost.fight_mode_data.panic
	accel_mult = current_ghost.fight_mode_data.accel_mult
	move_interval = current_ghost.fight_mode_data.movement_interval
	resize = current_ghost.fight_mode_data.scale
	scale = Vector2(resize,resize)


func choose_category():
	var total_weight = movement_weight + teleport_weight + special_weight
	var roll = randf_range(0.0, total_weight)

	if roll < movement_weight:
		return \"movement\"

	elif roll < movement_weight + teleport_weight:
		return \"teleport\"

	else:
		return \"special\"

func bounce_off_walls():
	var screen_size = get_viewport_rect().size

	if position.x <= radius:
		position.x = radius
		velocity.x = abs(velocity.x)

	elif position.x >= screen_size.x - radius:
		position.x = screen_size.x - radius
		velocity.x = -abs(velocity.x)

	if position.y <= radius:
		position.y = radius
		velocity.y = abs(velocity.y)

	elif position.y >= screen_size.y - radius:
		position.y = screen_size.y - radius
		velocity.y = -abs(velocity.y)

func get_direction(mouse: Vector2) -> Vector2:
	var screen_size = get_viewport_rect().size
	var center = screen_size / 2.0

	# Direction toward center, scaled by distance from center
	var screen_influence = Vector2(
		(center.x - position.x) / center.x,
		(center.y - position.y) / center.y
	)

	# Make screen influence weak near center and strong near edges
	screen_influence.x = sign(screen_influence.x) * pow(abs(screen_influence.x), 2)
	screen_influence.y = sign(screen_influence.y) * pow(abs(screen_influence.y), 2)

	# Direction away from mouse
	var mouse_vector = position - mouse
	var mouse_distance = mouse_vector.length()
	var mouse_direction = mouse_vector.normalized()

	# Mouse influence gets stronger as mouse gets closer
	var mouse_range = 400.0
	var mouse_strength = clamp(
		1.0 - mouse_distance / mouse_range,
		0.0,
		0.999
	)

	var mouse_influence = mouse_direction * mouse_strength

	# Let the two influences compete
	var direction = screen_influence + mouse_influence

	# Safety fallback if they somehow cancel
	if direction.length() < 0.001:
		direction = Vector2.RIGHT

	return direction.normalized()

func _process(delta: float) -> void:
	move_timer -= delta
	
	
	if move_timer <= 0:
		var timer_decrease = move_interval * current_pressure
		move_timer = (move_interval - timer_decrease) * randf_range(0.8, 1.2)
		var desired_direction = get_direction(get_global_mouse_position())
		var selected_move = move_list.choose_move(choose_category(),base_difficulty)
		turn_timer = 0
		selected_move[\"action\"].call(self, desired_direction)
		
func _physics_process(delta):
	if turn_timer > 0:
		velocity = velocity.rotated(turn_speed * delta)
		turn_timer -= delta

	if turn_timer <= 0:
			turn_speed = 0.0
	
	var current_speed = velocity.length()
	var acceleration = speed * accel_mult

	current_speed = move_toward(
		current_speed,
		speed,
		acceleration * delta
	)

	velocity = velocity.normalized() * current_speed

	position += velocity * delta

	bounce_off_walls()


func _on_area_2d_area_entered(area: Area2D) -> void:
	if area.is_in_group(\"watergun\"):
		print(\"ooh\")
		emit_signal(\"wet\")


func _on_area_2d_area_exited(area: Area2D) -> void:
	if area.is_in_group(\"watergun\"):
		
		emit_signal(\"wet\")


func _on_fight_mode_pressure_changed(pressure: Variant) -> void:
	current_pressure = pressure * panic
"

